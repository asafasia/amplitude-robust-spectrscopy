figure.figsize: 3.4, 2.6
figure.dpi: 200
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02

font.family: serif
font.serif: Times New Roman, Times, DejaVu Serif
mathtext.fontset: stix

font.size: 7
axes.labelsize: 7
axes.titlesize: 7
xtick.labelsize: 6
ytick.labelsize: 6
legend.fontsize: 6

axes.linewidth: 0.4
axes.grid: False

xtick.direction: in
ytick.direction: in
xtick.major.size: 2
ytick.major.size: 2
xtick.major.width: 0.5
ytick.major.width: 0.5
xtick.minor.visible: True
ytick.minor.visible: True

lines.linewidth: 0.5
lines.markersize: 4

legend.frameon: True
legend.handlelength: 1.5

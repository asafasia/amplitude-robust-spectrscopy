@article{rotem_limits_2019,
	title = {Limits on {Spectral} {Resolution} {Measurements} by {Quantum} {Probes}},
	volume = {122},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.122.060503},
	doi = {10.1103/PhysRevLett.122.060503},
	abstract = {The limits of frequency resolution in nano-NMR experiments have been discussed extensively in recent years. It is believed that there is a crucial difference between the ability to resolve a few frequencies and the precision of estimating a single one. Whereas the efficiency of single frequency estimation gradually increases with the square root of the number of measurements, the ability to resolve two frequencies is limited by the specific timescale of the signal and cannot be compensated for by extra measurements. Here we show theoretically and demonstrate experimentally that the relationship between these quantities is more subtle and both are only limited by the Cramér-Rao bound of a single frequency estimation.},
	number = {6},
	urldate = {2025-08-30},
	journal = {Physical Review Letters},
	author = {Rotem, Amit and Gefen, Tuvia and Oviedo-Casado, Santiago and Prior, Javier and Schmitt, Simon and Burak, Yoram and McGuiness, Liam and Jelezko, Fedor and Retzker, Alex},
	month = feb,
	year = {2019},
	note = {Publisher: American Physical Society},
	pages = {060503},
	file = {Full Text PDF:/Users/asafsolonnikov/Zotero/storage/JYV8B7JA/Rotem et al. - 2019 - Limits on Spectral Resolution Measurements by Quantum Probes.pdf:application/pdf},
}

@article{zhang_ramsey-biased_2020,
	title = {Ramsey-biased spectroscopy of superconducting qubits under dispersion},
	volume = {102},
	issn = {2469-9926, 2469-9934},
	url = {http://arxiv.org/abs/2004.08188},
	doi = {10.1103/PhysRevA.102.013710},
	abstract = {We proposed a spectroscopic method that extends Ramsey's atomic spectroscopy to detect the transition frequency of a qubit fabricated on a superconducting circuit. The method uses a multi-interval train of qubit biases to implement an alternate resonant and dispersive couplings to an incident probe field. The consequent absorption spectrum of the qubit has a narrower linewidth at its transition frequency than that obtained from constantly biasing the qubit to resonance while the middle dispersive evolution incurs only a negligible shift in detected frequency. Modeling on transmon qubits, we find that the linewidth reduction reaches 23\% and Ramsey fringes are simultaneously suppressed at extreme duration ratio of dispersion over resonance for a double-resonance scheme. If the scheme is augmented by an extra resonance segment, a further 37\% reduction can be achieved.},
	number = {1},
	urldate = {2025-09-07},
	journal = {Physical Review A},
	author = {Zhang, Yan and Huan, Tiantian and Zhou, Ri-gui and Ian, Hou},
	month = jul,
	year = {2020},
	note = {arXiv:2004.08188 [quant-ph]},
	keywords = {Quantum Physics, Physics - Optics},
	pages = {013710},
	file = {Preprint PDF:/Users/asafsolonnikov/Zotero/storage/RZPU8HR9/Zhang et al. - 2020 - Ramsey-biased spectroscopy of superconducting qubits under dispersion.pdf:application/pdf;Snapshot:/Users/asafsolonnikov/Zotero/storage/3ARUNWWB/2004.html:text/html},
}
